{
  "name": "squawksatoo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && xcopy src\\server\\server.js dist\\",
    "server": "node dist/server.js",
    "lint": "eslint .",
    "test": "vitest run --browser.headless",
    "test:watch": "vitest --browser.headless",
    "coverage": "vitest run --browser.headless --coverage",
    "coverage:watch": "vitest --browser.headless --coverage",
    "prep": "npm i && npm run lint && npm run coverage && npm run build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "random": "^5.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-rewards": "^2.1.0",
    "react-timer-hook": "^4.0.6",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vitest-browser-react": "^2.2.0"
  },
  "prettier": {
    "trailingComma": "none"
  }
}
